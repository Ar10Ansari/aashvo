# ====================================================================
# AASHVO NEON STAGING ENVIRONMENT TEMPLATE
# Database: aashvo_staging on Neon PostgreSQL (AWS Singapore ap-southeast-1)
# Project: aashvo-staging (small-butterfly-15738810)
# DO NOT COMMIT REAL CREDENTIALS TO GIT.
# ====================================================================

NODE_ENV=staging
PORT=10000
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# 1. Neon Staging Database Connections
# DATABASE_URL uses the connection pooler (port 5432 / 6543, pgbouncer=true) for API queries
DATABASE_URL=postgresql://aashvo_staging_owner:REPLACE_WITH_NEON_PASSWORD@ep-snowy-hall-bi49p4m9-pooler.c-5.ap-southeast-1.aws.neon.tech/aashvo_staging?sslmode=require&pgbouncer=true

# DIRECT_URL uses the direct compute endpoint for Prisma DDL schema migrations
DIRECT_URL=postgresql://aashvo_staging_owner:REPLACE_WITH_NEON_PASSWORD@ep-snowy-hall-bi49p4m9.c-5.ap-southeast-1.aws.neon.tech/aashvo_staging?sslmode=require

# 2. RSA-2048 JWT Keys (Staging Keypair Only)
JWT_SIGNING_PRIVATE_KEY="REPLACE_WITH_STAGING_RSA_PRIVATE_PEM"
JWT_SIGNING_PUBLIC_KEY="REPLACE_WITH_STAGING_RSA_PUBLIC_PEM"
JWT_ISSUER=https://api.staging.aashvo.in
JWT_AUDIENCE=aashvo-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 3. Security & Allowed Origins
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
WEB_APP_URL=https://aashvo-git-staging-mvp-fa-10591b-abdul-rehman-ansari-s-projects.vercel.app
CORS_ALLOWED_ORIGINS=https://aashvo-git-staging-mvp-fa-10591b-abdul-rehman-ansari-s-projects.vercel.app,https://aashvo-d5p98ri5p-abdul-rehman-ansari-s-projects.vercel.app
TRUST_PROXY=1
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# 4. Storage Configuration (Defaults to local for staging testing)
STORAGE_PROVIDER=local
LOCAL_STORAGE_BASE_DIR=./scratch/storage
LOCAL_STORAGE_PUBLIC_BASE_URL=https://aashvo-api-staging.onrender.com/assets

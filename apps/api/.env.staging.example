# ====================================================================
# AASHVO STAGING BACKEND CONFIGURATION TEMPLATE
# Service: aashvo-api-staging.onrender.com
# Environment: staging
# Never commit real secrets or production credentials to Git.
# ====================================================================

NODE_ENV=staging
PORT=10000
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# 1. Staging Database (Separate Supabase Staging Project / Neon Staging Branch)
# DO NOT REUSE PRODUCTION CREDENTIALS
DATABASE_URL=postgresql://staging_user:staging_secret@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20
DIRECT_URL=postgresql://staging_user:staging_secret@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# 2. RSA-2048 Asymmetric JWT Keypair (Staging Key Only)
# Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_SIGNING_PRIVATE_KEY="REPLACE_WITH_STAGING_RSA_PRIVATE_PEM"
JWT_SIGNING_PUBLIC_KEY="REPLACE_WITH_STAGING_RSA_PUBLIC_PEM"
JWT_ISSUER=https://api.staging.aashvo.in
JWT_AUDIENCE=aashvo-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 3. Cookie Security & Cross-Domain Settings
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# 4. Allowed Origins (Vercel Preview & Staging Domains)
WEB_APP_URL=https://aashvo-d5p98ri5p-abdul-rehman-ansari-s-projects.vercel.app
CORS_ALLOWED_ORIGINS=https://aashvo-d5p98ri5p-abdul-rehman-ansari-s-projects.vercel.app,https://aashvo-git-staging-mvp-fa-10591b-abdul-rehman-ansari-s-projects.vercel.app
TRUST_PROXY=1

# 5. Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# 6. Real Cloud Storage (Cloudflare R2 + AWS S3 Mumbai)
STORAGE_PROVIDER=cloud

# Cloudflare R2 Public Listing Photos (staging bucket)
CLOUDFLARE_R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_R2_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_WITH_CLOUDFLARE_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_WITH_CLOUDFLARE_R2_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET_NAME=aashvo-staging-public
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.staging.aashvo.in

# AWS S3 Mumbai Encrypted Private Vault (staging bucket)
AWS_REGION=ap-south-1
AWS_S3_PRIVATE_BUCKET=aashvo-staging-vault
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY

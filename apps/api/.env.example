# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# Database (Isolated Local PostgreSQL on port 5433 via docker-compose or local initdb)
# Never place production or hosted Supabase credentials in local files or git.
DATABASE_URL=postgresql://postgres:aashvo_local_dev_only@127.0.0.1:5433/aashvo_dev?schema=public

# Asymmetric RS256 JWT Keypair (RSA 2048+ PEM, escape newlines with \n for single-line env)
# Generate locally with:
#   node -e "const {generateKeyPairSync}=require('crypto');const k=generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('JWT_SIGNING_PRIVATE_KEY=\"'+k.privateKey.replace(/\n/g,'\\n')+'\"');console.log('JWT_SIGNING_PUBLIC_KEY=\"'+k.publicKey.replace(/\n/g,'\\n')+'\"')"
JWT_SIGNING_PRIVATE_KEY="REPLACE_WITH_LOCAL_RSA_PRIVATE_PEM"
JWT_SIGNING_PUBLIC_KEY="REPLACE_WITH_LOCAL_RSA_PUBLIC_PEM"
JWT_ISSUER=https://api.aashvo.in
JWT_AUDIENCE=aashvo-clients
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Frontend URL & HTTP Security
WEB_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Rate Limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Media & Storage Vault Configuration
# Provider selection: 'local' (default for development/tests) or 'cloud' (staging/production)
STORAGE_PROVIDER=local
LOCAL_STORAGE_BASE_DIR=./scratch/storage
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:4000/assets

# Prepared Cloud Storage (Used when STORAGE_PROVIDER=cloud in staging/production)
# Public assets (property photos, avatars): Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=aashvo-public-assets
CLOUDFLARE_R2_PUBLIC_URL=https://assets.aashvo.in

# Private vault (rental agreements, KYC docs): AWS S3 ap-south-1 Mumbai
AWS_REGION=ap-south-1
AWS_S3_PRIVATE_BUCKET=aashvo-private-vault
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

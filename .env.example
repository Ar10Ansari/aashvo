# ====================================================================
# AASHVO ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local overrides. Never commit .env or secrets to Git.
# ====================================================================

# 1. API & Backend Configuration
VITE_API_BASE_URL=https://aashvo-api.onrender.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Supabase Client Configuration (Browser / Public Safe)
# Find in Supabase Dashboard -> Project Settings -> API
# Region: ap-south-1 (Mumbai, India)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Application Environment & Marketplace Scope
VITE_APP_ENV=development
VITE_MARKETPLACE_REGION="Pan-India"

# ====================================================================
# SERVER-SIDE & THIRD-PARTY PROVIDER REFERENCES (SUPABASE DASHBOARD)
# DO NOT ADD VITE_ PREFIX TO PRIVILEGED SECRETS OR SERVICE ROLE KEYS.
# All privileged settings below belong in Supabase Dashboard, NOT in the frontend bundle.
# ====================================================================
# - Supabase Auth -> Providers -> Google:
#   Client ID: <configured-in-gcp-console>.apps.googleusercontent.com
#   Client Secret: <configured-in-supabase-dashboard>
#   Authorized Redirect URI: https://<your-project-id>.supabase.co/auth/v1/callback
#
# - Supabase Auth -> SMTP / Email:
#   Provider: Resend / SendGrid / Amazon SES
#   Sender Email: notifications@aashvo.com
#
# - Supabase Auth -> Phone (SMS OTP):
#   Provider: Twilio / MessageCentral / Msg91
# ====================================================================

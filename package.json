{
  "name": "aashvo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run contracts:build && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "contracts:build": "npm --workspace=packages/contracts run build",
    "api:dev": "npm --workspace=apps/api run start:dev",
    "api:build": "npm --workspace=apps/api run build",
    "api:test": "npm --workspace=apps/api test",
    "api:prisma:validate": "npm --workspace=apps/api run prisma:validate",
    "api:openapi": "npm --workspace=apps/api run openapi:generate"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vitest": "^5.0.5"
  }
}
